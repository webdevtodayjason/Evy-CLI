#!/usr/bin/env python3
"""Evy Mail: safe Resend email sender with recipient whitelist.

Default local config:
  ~/.hermes/evy-mail/config.json
  ~/.hermes/evy-mail/recipients.json

Secrets live in environment variables or ~/.hermes/.env, not in config.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

APP_DIR = Path.home() / ".hermes" / "evy-mail"
CONFIG_PATH = APP_DIR / "config.json"
WHITELIST_PATH = APP_DIR / "recipients.json"
DEFAULT_CONFIG = {
    "api_key_env": "RESEND_API_KEY",
    "from": "Evy <evy@evysnook.com>",
    "resend_endpoint": "https://api.resend.com/emails",
}
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def load_dotenv() -> None:
    env = Path.home() / ".hermes" / ".env"
    if not env.exists():
        return
    for raw in env.read_text(errors="ignore").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k and k not in os.environ:
            os.environ[k] = v.strip().strip('"').strip("'")


def ensure_files() -> None:
    APP_DIR.mkdir(parents=True, exist_ok=True)
    APP_DIR.chmod(0o700)
    if not CONFIG_PATH.exists():
        write_json(CONFIG_PATH, DEFAULT_CONFIG)
    if not WHITELIST_PATH.exists():
        write_json(WHITELIST_PATH, {"recipients": []})


def read_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n")
    path.chmod(0o600)


def config() -> dict[str, Any]:
    ensure_files()
    cfg = DEFAULT_CONFIG.copy()
    cfg.update(read_json(CONFIG_PATH, {}))
    return cfg


def whitelist() -> list[dict[str, str]]:
    ensure_files()
    data = read_json(WHITELIST_PATH, {"recipients": []})
    return list(data.get("recipients", []))


def normalize_email(email: str) -> str:
    return email.strip().lower()


def valid_email(email: str) -> bool:
    return bool(EMAIL_RE.match(email.strip()))


def recipient_allowed(email: str) -> bool:
    e = normalize_email(email)
    return any(normalize_email(r.get("email", "")) == e for r in whitelist())


def output(obj: Any, as_json: bool = True) -> None:
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False, sort_keys=True))
    else:
        print(obj)


def cmd_init(args: argparse.Namespace) -> None:
    ensure_files()
    cfg = config()
    changed = False
    if args.from_email:
        cfg["from"] = args.from_email
        changed = True
    if args.api_key_env:
        cfg["api_key_env"] = args.api_key_env
        changed = True
    if args.endpoint:
        cfg["resend_endpoint"] = args.endpoint
        changed = True
    if changed:
        write_json(CONFIG_PATH, cfg)
    output({"ok": True, "config_path": str(CONFIG_PATH), "whitelist_path": str(WHITELIST_PATH), "config": safe_config(cfg)})


def safe_config(cfg: dict[str, Any]) -> dict[str, Any]:
    return {k: v for k, v in cfg.items() if "key" not in k.lower() or k.endswith("_env")}


def cmd_config(args: argparse.Namespace) -> None:
    cfg = config()
    if args.set_from:
        cfg["from"] = args.set_from
    if args.set_api_key_env:
        cfg["api_key_env"] = args.set_api_key_env
    if args.set_endpoint:
        cfg["resend_endpoint"] = args.set_endpoint
    if args.set_from or args.set_api_key_env or args.set_endpoint:
        write_json(CONFIG_PATH, cfg)
    output({"config_path": str(CONFIG_PATH), "config": safe_config(cfg)})


def cmd_whitelist(args: argparse.Namespace) -> None:
    ensure_files()
    rows = whitelist()
    if args.whitelist_cmd == "list":
        output({"whitelist_path": str(WHITELIST_PATH), "recipients": rows})
        return
    email = normalize_email(args.email)
    if not valid_email(email):
        sys.exit(f"invalid email address: {args.email}")
    if args.whitelist_cmd == "add":
        existing = [r for r in rows if normalize_email(r.get("email", "")) == email]
        if existing:
            existing[0]["label"] = args.label or existing[0].get("label", "")
            existing[0]["updated_at"] = now()
        else:
            rows.append({"email": email, "label": args.label or "", "added_at": now()})
        write_json(WHITELIST_PATH, {"recipients": sorted(rows, key=lambda r: r["email"])})
        output({"ok": True, "added": email, "whitelist_path": str(WHITELIST_PATH)})
    elif args.whitelist_cmd == "remove":
        new_rows = [r for r in rows if normalize_email(r.get("email", "")) != email]
        write_json(WHITELIST_PATH, {"recipients": new_rows})
        output({"ok": True, "removed": email, "changed": len(new_rows) != len(rows)})


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_body(args: argparse.Namespace) -> tuple[str | None, str | None]:
    text = args.text
    html = args.html
    if args.text_file:
        text = Path(args.text_file).read_text()
    if args.html_file:
        html = Path(args.html_file).read_text()
    if text is None and html is None and not sys.stdin.isatty():
        text = sys.stdin.read()
    return text, html


def cmd_send(args: argparse.Namespace) -> None:
    load_dotenv()
    cfg = config()
    sender = args.from_email or cfg.get("from")
    api_key_env = args.api_key_env or cfg.get("api_key_env", "RESEND_API_KEY")
    api_key = os.environ.get(api_key_env)
    to = [normalize_email(x) for x in args.to]
    cc = [normalize_email(x) for x in (args.cc or [])]
    bcc = [normalize_email(x) for x in (args.bcc or [])]
    all_recipients = to + cc + bcc
    blocked = [e for e in all_recipients if not recipient_allowed(e)]
    if blocked:
        output({
            "ok": False,
            "error": "recipient_not_whitelisted",
            "blocked": blocked,
            "hint": "Approve recipients first: evy-mail whitelist add person@example.com --label 'Name'",
        })
        sys.exit(2)
    if not api_key and not args.dry_run:
        sys.exit(f"missing API key env var: {api_key_env}")
    text, html = read_body(args)
    if not text and not html:
        sys.exit("message body required via --text, --html, --text-file, --html-file, or stdin")
    payload: dict[str, Any] = {"from": sender, "to": to, "subject": args.subject}
    if text:
        payload["text"] = text
    if html:
        payload["html"] = html
    if args.reply_to:
        payload["reply_to"] = args.reply_to
    if cc:
        payload["cc"] = cc
    if bcc:
        payload["bcc"] = bcc
    if args.dry_run:
        redacted = payload.copy()
        redacted["body_preview"] = (text or html or "")[:300]
        redacted.pop("text", None)
        redacted.pop("html", None)
        output({"ok": True, "dry_run": True, "payload": redacted, "api_key_env": api_key_env})
        return
    auth_header = "Authorization: " + "Bearer " + api_key
    cmd = [
        "curl", "-sS", "-X", "POST", cfg.get("resend_endpoint", DEFAULT_CONFIG["resend_endpoint"]),
        "-H", auth_header,
        "-H", "Content-Type: application/json",
        "--data", json.dumps(payload),
    ]
    proc = subprocess.run(cmd, text=True, capture_output=True, timeout=60)

    raw = proc.stdout.strip() or proc.stderr.strip()
    try:
        res = json.loads(raw) if raw else {}
    except Exception:
        res = {"raw": raw}
    if proc.returncode != 0:
        output({"ok": False, "exit_code": proc.returncode, "response": res})
        sys.exit(proc.returncode)
    ok = "id" in res
    output({"ok": ok, "response": res, "to": to, "from": sender})
    if not ok:
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(prog="evy-mail", description="Safe Resend email sender with approved-recipient whitelist")
    sub = parser.add_subparsers(dest="cmd", required=True)

    init = sub.add_parser("init", help="create config and whitelist files")
    init.add_argument("--from", dest="from_email")
    init.add_argument("--api-key-env")
    init.add_argument("--endpoint")
    init.set_defaults(func=cmd_init)

    cfg = sub.add_parser("config", help="show or update non-secret config")
    cfg.add_argument("--set-from")
    cfg.add_argument("--set-api-key-env")
    cfg.add_argument("--set-endpoint")
    cfg.set_defaults(func=cmd_config)

    wl = sub.add_parser("whitelist", help="manage approved recipients")
    wl_sub = wl.add_subparsers(dest="whitelist_cmd", required=True)
    wl_list = wl_sub.add_parser("list", help="list approved recipients")
    wl_list.set_defaults(func=cmd_whitelist)
    wl_add = wl_sub.add_parser("add", help="approve a recipient")
    wl_add.add_argument("email")
    wl_add.add_argument("--label", default="")
    wl_add.set_defaults(func=cmd_whitelist)
    wl_rm = wl_sub.add_parser("remove", help="remove an approved recipient")
    wl_rm.add_argument("email")
    wl_rm.set_defaults(func=cmd_whitelist)

    send = sub.add_parser("send", help="send an email to whitelisted recipients")
    send.add_argument("--to", action="append", required=True, help="approved recipient; repeat for multiple")
    send.add_argument("--cc", action="append")
    send.add_argument("--bcc", action="append")
    send.add_argument("--subject", required=True)
    send.add_argument("--text")
    send.add_argument("--html")
    send.add_argument("--text-file")
    send.add_argument("--html-file")
    send.add_argument("--from", dest="from_email")
    send.add_argument("--reply-to")
    send.add_argument("--api-key-env")
    send.add_argument("--dry-run", action="store_true")
    send.set_defaults(func=cmd_send)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
